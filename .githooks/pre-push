#!/bin/sh
# Controlli prima del push — Flow-Wise server
#
# Esegue i test e rifiuta il push se falliscono. Non c'e' piu' un'approvazione per SHA:
# la decisione di pubblicare spetta a Gio, e l'agente fa push solo dopo il suo ok
# esplicito in conversazione.
set -u

repo=$(git rev-parse --show-toplevel)
cd "$repo" || exit 1

fail() {
  echo "[pre-push] CHECK FALLITO: $1 — push rifiutato."
  exit 1
}

# 1) Invarianti (node --test). Un test rosso ferma il push qui: nessun `|| true`,
#    nessuno skip condizionale, nessuna suite vuota silenziosa.
echo "[pre-push] npm test (node --test)"
npm test || fail "test backend (node --test)"

# 2) JavaScript puro, quindi il controllo di sintassi sostituisce il typecheck.
count=0
for file in $(find . -name '*.js' -not -path './node_modules/*'); do
  node --check "$file" || fail "sintassi: $file"
  count=$((count + 1))
done
echo "[pre-push] node --check superato su $count file"

echo "[pre-push] check superati: push consentito."
exit 0
