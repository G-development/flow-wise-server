PORT=5030

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL and service_role key (legacy JWT variant)
SUPABASE_URL=HERE
SUPABASE_SERVICE_ROLE_KEY=HERE

# AI expense analytics agent (Groq, OpenAI-compatible API)
LLM_API_KEY=your_groq_api_key
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

CLOUDINARY_CLOUD_NAME=HERE
CLOUDINARY_API_KEY=HERE
CLOUDINARY_API_SECRET=HERE

# Open Banking / PSD2 Configuration
# "mock" abilita la sandbox; qualsiasi altro valore (o l'assenza della variabile) lascia
# il server in modalità live, che richiede le credenziali GoCardless documentate sotto.
BANK_PROVIDER=mock
BANK_REDIRECT_URI=http://localhost:5030/bank/callback
BANK_CLIENT_REDIRECT_URI=http://localhost:3000/settings/yourbank

# Abilita ESPLICITAMENTE i movimenti simulati (mock) e la sandbox /bank/mock-auth.
# Va lasciato `false` (o assente) in live: con il mock disabilitato un errore del provider
# bancario resta un errore, non diventa mai un movimento finto.
BANK_MOCK_ENABLED=false

# Chiave dedicata per la cifratura at-rest dei token bancari (AES-256-GCM).
# Generala con: openssl rand -hex 32
# Non cambiarla a caldo: i token già cifrati diventano illeggibili (riconnettere le banche).
# Se assente si ricade su BANK_CLIENT_SECRET e infine su SUPABASE_SERVICE_ROLE_KEY.
BANK_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Credenziali GoCardless: richieste dalla modalità live (vedi BANK_PROVIDER sopra).
GOCARDLESS_SECRET_ID=your_gocardless_secret_id
GOCARDLESS_SECRET_KEY=your_gocardless_secret_key

# Bank Sync Scheduler - Cron pattern per sincronizzazione automatica
# Default: "0 * * * *" (ogni ora)
BANK_SYNC_CRON=0 * * * *
BANK_SCHEDULER_SECRET=replace_with_a_long_random_secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@flow-wise.com
