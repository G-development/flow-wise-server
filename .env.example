PORT=5030

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL and service_role key (legacy JWT variant)
# NOTE: Use the legacy service_role key (starts with eyJ...) on the server to bypass RLS.
SUPABASE_URL=HERE
SUPABASE_SERVICE_ROLE_KEY=HERE

CLOUDINARY_CLOUD_NAME=HERE
CLOUDINARY_API_KEY=HERE
CLOUDINARY_API_SECRET=HERE
CLOUDINARY_API=CLOUDINARY_URL=HERE

# Open Banking / PSD2 Configuration (per banche italiane)
# Registra un'app presso la banca per ottenere client_id e client_secret
BANK_CLIENT_ID=your_client_id
BANK_CLIENT_SECRET=your_client_secret
BANK_REDIRECT_URI=http://localhost:5030/bank/callback
BANK_CLIENT_REDIRECT_URI=http://localhost:3000/settings/yourbank

# Bank Sync Scheduler - Cron pattern per sincronizzazione automatica
# Default: "0 * * * *" (ogni ora)
# Esempi:
#   "0 */6 * * *" = ogni 6 ore
#   "0 0 * * *" = ogni giorno a mezzanotte
#   "0 9,14,18 * * *" = ore 9, 14, 18
#   "*/15 * * * *" = ogni 15 minuti
BANK_SYNC_CRON=0 * * * *
BANK_SCHEDULER_SECRET=replace_with_a_long_random_secret

# Email Configuration (SMTP)
# Configura il tuo provider email (Gmail, SendGrid, AWS SES, ecc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@flow-wise.com